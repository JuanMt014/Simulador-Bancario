NODE_ENV=development
PORT=3000

# En producción, usa el dominio del frontend. Se admiten varios orígenes separados por coma.
CORS_ORIGIN=http://localhost:5500

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=simulador_bancario
DB_CONNECTION_LIMIT=10

# Usa un secreto aleatorio distinto en cada entorno (mínimo 32 caracteres).
JWT_SECRET=reemplazar_por_un_secreto_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=1h
